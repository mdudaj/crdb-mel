                              {
                                "participationtypemask": 2,
                                "partyid_contact@odata.bind": "@{concat('/contacts(', body('Parse_JSON')?['contactId'], ')')}"
                              }
                            ],
                            "subject": "@{concat('Impact Monitoring access updated - ', coalesce(body('Parse_JSON')?['projectName'], 'Project assignment'))}"
