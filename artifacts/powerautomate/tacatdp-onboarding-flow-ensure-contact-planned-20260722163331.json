                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord"
                },
                "parameters": {
                  "entityName": "contacts",
                  "item": {
                    "emailaddress1": "@body('Parse_JSON')?['email']",
                    "fullname": "@body('Parse_JSON')?['fullName']",
